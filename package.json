{
  "name": "listflix",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @listflix/extension dev",
    "build": "pnpm -r build",
